+type Sched = [number, Payload, boolean?];
+/** What the listing shows when a poll begins: [status, waitingFor], or null for "no poll ran". */
+type Screen = (at: number) => [string, string?] | null;
+
+async function sim(events: Sched[], screen: Screen, end: number, phase = 0) {
+  const h = harness();
+  const evs = [...events].sort((a, b) => a[0] - b[0]);
+  const pending: { land: number; start: number; s: [string, string?] }[] = [];
+  for (let ms = 0; ms <= end; ms += 100) {
+    h.at(ms);
+    while (evs.length > 0 && (evs[0] as Sched)[0] <= ms) {
+      const [, p, codex] = evs.shift() as Sched;
+      h.hook(p, codex === true);
+    }
+    if (ms >= phase && (ms - phase) % 5_000 === 0) {
+      const s = screen(ms);
+      if (s !== null) pending.push({ land: ms + LAND, start: ms, s });
+    }
+    for (const p of pending.filter((x) => x.land === ms)) h.poll(p.s[0], p.start, p.s[1]);
+    if (ms % 1_000 === 0) await h.pulse();
+    // Design D's optional confirming poll: the daemon asks the listing once a
+    // dialog reaches its dwell unproven (SCORE_CONFIRM=1, D tree only).
+    // biome-ignore lint/suspicious/noExplicitAny: only the D prototype has it
+    const due = (h.registry as any).dialogCheckDue;
+    if (CONFIRM && typeof due === "function" && due.call(h.registry)) {
+      const s = screen(ms);
+      if (s !== null) pending.push({ land: ms + LAND, start: ms, s });
+    }
+  }
+  return h;
