+function harness() {
+  let t = 0;
+  let n = 0;
+  const now = () => t;
+  const sent: NotifyEnvelope[] = [];
+  const target: DeliveryTarget = { name: "test", live: () => true, deliver: async (e) => (sent.push(e), { ok: true }) };
+  const registry = new Registry({ nowMs: now });
+  const loop = new NotifyLoop({ registry, policy: new NotifyPolicy(), dispatcher: new Dispatcher([target]), now });
+  const hook = (payload: Payload, codex = false) => {
+    const r = codex
+      ? normalizeCodexHook(payload, { ...deps, newId: () => `c${++n}` })
+      : normalizeClaudeHook(payload, { ...deps, newId: () => `e${++n}` });
+    if (r.event === null) return undefined; // PermissionRequest is unmapped on main
+    return registry.apply(r.event, r.cwd);
+  };
+  const row = (status: string | null, waitingFor?: string, sessionId = S) => {
+    const screen = claudeScreen?.(status, waitingFor ?? null);
+    return { sessionId, cwd: CWD, pid: 4242, status, name: "repo", startedAt: null, ...(screen ? { screen } : {}) };
+  };
+  const poll = (status: string | null, startedAt = t, waitingFor?: string, rows?: unknown[]) =>
+    // biome-ignore lint/suspicious/noExplicitAny: observedAt is unknown to main's signature
+    (registry.reconcile as any)(rows ?? [row(status, waitingFor)], {
+      provider: "claude",
+      complete: true,
+      observedAt: startedAt,
+    });
+  const seen = (startedAt = t) => poll("waiting", startedAt, DIALOG);
+  const agent = (id = S) => registry.get(S)?.agents.get(id);
+  const pulse = async () => {
+    registry.tick();
+    await loop.pulse();
+  };
+  const pollFor = async (status: string | null, from: number, to: number, waitingFor?: string) => {
+    for (let at = from; at <= to; at += 5_000) {
+      t = at + 300;
+      poll(status, at, waitingFor);
+      t = at + 1_000;
+      await pulse();
+    }
+  };
+  return { registry, loop, sent, hook, poll, seen, agent, pulse, pollFor, at: (ms: number) => void (t = ms), now };
+}
+type H = ReturnType<typeof harness>;
+const who = (id: string) => (id === S ? "main" : id.slice(0, 3));
