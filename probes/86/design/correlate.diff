+  open(sessionId: string, agentId: string, tool: string, input: unknown, callId: string): void {
+    const m = this.calls(sessionId);
+    m.set(callId, { callId, agentId, tool, digest: digestOf(input), seq: ++this.seq, claimed: false });
+    while (m.size > MAX_OPEN) {
+      const oldest = m.keys().next().value;
+      if (oldest === undefined) break;
+      m.delete(oldest);
+    }
+  }
+
+  /**
+   * The open, unclaimed call this ask is about.
+   *
+   * Same tool and same input hash; the agent too when the ask names one (a
+   * subagent's does, read from the 2.1.312 binary: `PermissionRequest` gets
+   * the tool-use context and so its `agent_id`). With no agent named, the main
+   * agent's call is preferred — that is whose an agent-less ask is, by the
+   * same reading — and any agent's otherwise, so this still works if the
+   * binary reading is wrong. Oldest first: asks are raised in the order their
+   * calls started. A hook that rewrote the input (PreToolUse `updatedInput`)
+   * breaks the hash, so the fallback is the same agent and tool, oldest first.
+   */
+  claim(sessionId: string, agentId: string | null, tool: string, input: unknown): { callId: string; agentId: string } | null {
+    const m = this.sessions.get(sessionId);
+    if (m === undefined) return null;
+    const d = digestOf(input);
+    const open = [...m.values()].filter((c) => !c.claimed && c.tool === tool).sort((a, b) => a.seq - b.seq);
+    const byAgent = (c: OpenCall) => agentId === null || c.agentId === agentId;
+    const exact = open.filter((c) => c.digest === d && byAgent(c));
+    let pick: OpenCall | undefined;
+    if (agentId === null) pick = exact.find((c) => c.agentId === sessionId) ?? exact[0];
+    else pick = exact[0];
+    if (pick === undefined && agentId !== null) pick = open.find((c) => c.agentId === agentId);
+    if (pick === undefined) return null;
+    pick.claimed = true;
+    return { callId: pick.callId, agentId: pick.agentId };
+  }
+
+  close(sessionId: string, callId: string): void {
+    this.sessions.get(sessionId)?.delete(callId);
+  }
+
+  closeAgent(sessionId: string, agentId: string): void {
+    const m = this.sessions.get(sessionId);
+    if (m === undefined) return;
+    for (const [id, c] of m) if (c.agentId === agentId) m.delete(id);
+  }
+
+  closeSession(sessionId: string): void {
+    this.sessions.delete(sessionId);
+  }
+}
