index 0000000..2ac16a2
--- /dev/null
+++ b/src/adapters/claude/correlate.ts
@@ -0,0 +1,121 @@
+/**
+ * #86 candidate B — which call a Claude `PermissionRequest` is about.
+ *
+ * `PermissionRequest` carries `session_id`, `tool_name` and `tool_input`, but
+ * no `tool_use_id` (measured, test/fixtures/claude/permission-request.json) —
+ * and for the main agent no `agent_id` either, since the main agent never has
+ * one. Its `tool_input` is the PreToolUse's, unchanged (same fixture). So the
+ * PreToolUse it follows is found by (session, agent if named, tool, a hash of
+ * the input); that PreToolUse carries the `tool_use_id` and the agent.
+ *
+ * SEC-01: the input is hashed here, in memory, and only the hash is kept. It is
+ * never written, never logged, never put on an event. What leaves this file is
+ * a `tool_use_id` and an agent id.
+ */
+
+import { createHash } from "node:crypto";
+import type { CallCorrelator } from "../types.js";
+
+interface OpenCall {
+  callId: string;
+  agentId: string;
+  tool: string;
+  digest: string;
+  seq: number;
+  claimed: boolean;
+}
+
+/** Calls kept per session; a session with more open calls than this is pathological. */
+const MAX_OPEN = 256;
+/** Sessions kept; the least recently touched goes first. */
+const MAX_SESSIONS = 512;
+
+/** Key-order-independent JSON, so the same input always hashes the same. */
+function stable(v: unknown): string {
+  if (v === null || typeof v !== "object") return JSON.stringify(v) ?? "null";
+  if (Array.isArray(v)) return `[${v.map(stable).join(",")}]`;
+  const o = v as Record<string, unknown>;
+  return `{${Object.keys(o)
+    .sort()
+    .map((k) => `${JSON.stringify(k)}:${stable(o[k])}`)
+    .join(",")}}`;
+}
+
+function digestOf(input: unknown): string {
+  return createHash("sha256").update(stable(input)).digest("base64url").slice(0, 22);
+}
+
+export class ClaudeCallCorrelator implements CallCorrelator {
+  private sessions = new Map<string, Map<string, OpenCall>>();
+  private seq = 0;
+
+  private calls(sessionId: string): Map<string, OpenCall> {
+    let m = this.sessions.get(sessionId);
+    if (m === undefined) {
+      m = new Map();
+      this.sessions.set(sessionId, m);
+      while (this.sessions.size > MAX_SESSIONS) {
+        const oldest = this.sessions.keys().next().value;
+        if (oldest === undefined) break;
+        this.sessions.delete(oldest);
+      }
+    } else {
+      // Most recently touched last.
+      this.sessions.delete(sessionId);
+      this.sessions.set(sessionId, m);
+    }
+    return m;
+  }
+
+  open(sessionId: string, agentId: string, tool: string, input: unknown, callId: string): void {
+    const m = this.calls(sessionId);
+    m.set(callId, { callId, agentId, tool, digest: digestOf(input), seq: ++this.seq, claimed: false });
+    while (m.size > MAX_OPEN) {
+      const oldest = m.keys().next().value;
+      if (oldest === undefined) break;
+      m.delete(oldest);
+    }
+  }
+
+  /**
+   * The open, unclaimed call this ask is about.
+   *
+   * Same tool and same input hash; the agent too when the ask names one (a
+   * subagent's does, read from the 2.1.312 binary: `PermissionRequest` gets
+   * the tool-use context and so its `agent_id`). With no agent named, the main
+   * agent's call is preferred — that is whose an agent-less ask is, by the
+   * same reading — and any agent's otherwise, so this still works if the
+   * binary reading is wrong. Oldest first: asks are raised in the order their
+   * calls started. A hook that rewrote the input (PreToolUse `updatedInput`)
+   * breaks the hash, so the fallback is the same agent and tool, oldest first.
+   */
+  claim(sessionId: string, agentId: string | null, tool: string, input: unknown): { callId: string; agentId: string } | null {
+    const m = this.sessions.get(sessionId);
+    if (m === undefined) return null;
+    const d = digestOf(input);
+    const open = [...m.values()].filter((c) => !c.claimed && c.tool === tool).sort((a, b) => a.seq - b.seq);
+    const byAgent = (c: OpenCall) => agentId === null || c.agentId === agentId;
+    const exact = open.filter((c) => c.digest === d && byAgent(c));
+    let pick: OpenCall | undefined;
+    if (agentId === null) pick = exact.find((c) => c.agentId === sessionId) ?? exact[0];
+    else pick = exact[0];
+    if (pick === undefined && agentId !== null) pick = open.find((c) => c.agentId === agentId);
+    if (pick === undefined) return null;
+    pick.claimed = true;
+    return { callId: pick.callId, agentId: pick.agentId };
+  }
+
+  close(sessionId: string, callId: string): void {
+    this.sessions.get(sessionId)?.delete(callId);
+  }
+
+  closeAgent(sessionId: string, agentId: string): void {
+    const m = this.sessions.get(sessionId);
+    if (m === undefined) return;
+    for (const [id, c] of m) if (c.agentId === agentId) m.delete(id);
+  }
+
+  closeSession(sessionId: string): void {
+    this.sessions.delete(sessionId);
+  }
+}
