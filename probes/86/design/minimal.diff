+  for (const [at, payload] of o.hooks) steps.push({ at, order: 0, go: () => h.hook(payload) });
+  if (o.screen !== null) {
+    const screen = o.screen;
+    for (let b = o.phase ?? 0; b <= o.until; b += 5_000) {
+      const [status, waitingFor] = screen(b);
+      steps.push({ at: b + (o.land ?? 300), order: 1, go: () => h.poll(status, waitingFor, b) });
+    }
+  }
+  for (let at = o.pulseAt ?? 0; at <= o.until; at += 1_000) steps.push({ at, order: 2, go: () => h.pulse() });
+  const samples: Record<string, string> = {};
+  for (const s of o.samples ?? []) steps.push({ at: s, order: 3, go: () => (samples[`@${s / 1000}`] = st(h)) });
+  steps.sort((a, b) => a.at - b.at || a.order - b.order);
+  for (const s of steps) {
+    h.at(s.at);
+    await s.go();
+  }
+  return { h, samples };
