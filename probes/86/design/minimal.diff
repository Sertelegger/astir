+/**
+ * The daemon's cadence on one clock: each hook at its time; a poll begun every
+ * 5 s from `phase`, landing `land` ms later with what was on screen when it
+ * began (none when `screen` is null: discovery down); a tick and a pulse every
+ * second, offset by `pulseAt`. Same instant: hooks, then polls, then the pulse.
+ */
+async function run(o: {
+  hooks: Array<[number, Payload]>;
+  screen: Screen | null;
+  until: number;
+  phase?: number;
+  land?: number;
+  pulseAt?: number;
+  samples?: number[];
