+type Payload = Record<string, unknown>;
+type Step = { afterMs: number; payload: Payload };
+const capture = JSON.parse(
+  readFileSync(join(root, "test", "fixtures", "claude", "permission-request.json"), "utf8"),
+) as { sequence: Step[] };
+const codexCap = JSON.parse(readFileSync(join(root, "test", "fixtures", "codex", "capture.json"), "utf8")) as Record<
+  string,
+  Step[]
