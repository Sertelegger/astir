+/**
+ * #86 — an opaque digest of a call's tool name and input (`AstirEvent.callKey`).
+ * Keys are sorted so the same input always digests the same. In memory only.
+ */
+export function callKeyOf(tool: unknown, input: unknown): string | null {
+  if (typeof tool !== "string") return null;
+  const canon = (v: unknown): unknown => {
+    if (Array.isArray(v)) return v.map(canon);
+    if (v !== null && typeof v === "object") {
+      const o = v as Record<string, unknown>;
+      return Object.fromEntries(
+        Object.keys(o)
+          .sort()
+          .map((k) => [k, canon(o[k])]),
+      );
+    }
+    return v;
+  };
+  return createHash("sha256")
+    .update(`${tool}\u0000${JSON.stringify(canon(input ?? null))}`)
+    .digest("hex")
+    .slice(0, 32);
