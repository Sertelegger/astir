+ * (landing 300 ms later), then tick + pulse every 1 s.
+ */
+async function sim(events: Sched[], screen: Screen, end: number, phase = 0, watch: string[] = [SESSION]) {
+  const h = harness();
+  const evs = [...events].sort((a, b) => a[0] - b[0]);
+  const pending: { land: number; start: number; s: [string | null, string?] }[] = [];
+  const trace: string[] = [];
+  const last = new Map<string, string>();
+  for (let ms = 0; ms <= end; ms += 100) {
+    h.at(ms);
+    while (evs.length > 0 && (evs[0] as Sched)[0] <= ms) {
+      const e = evs.shift() as Sched;
+      h.hook(e[1], e[2] ?? "claude");
+    }
+    if (screen !== null && ms >= phase && (ms - phase) % 5_000 === 0) pending.push({ land: ms + 300, start: ms, s: screen(ms) });
+    for (const p of pending.filter((x) => x.land === ms)) h.poll(p.s[0], p.start, p.s[1]);
+    if (ms % 1_000 === 0) {
+      h.registry.tick();
+      await h.loop.pulse();
+    }
+    for (const id of watch) {
+      const a = h.agent(id);
+      const st = a ? `${a.state}${a.blockedReason ? `/${a.blockedReason}` : ""}${a.tool ? `:${a.tool}` : ""}` : "none";
+      if (last.get(id) !== st) {
+        trace.push(`@${ms / 1000} ${id === SESSION ? "main" : id.slice(0, 3)}=${st}`);
+        last.set(id, st);
+      }
+    }
+  }
+  const sent = h.sent.map((e) => `${e.kind}:${who(e)}:${e.reason}@${e.ts / 1000}`);
+  return { h, sent, trace };
