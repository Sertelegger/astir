+const PHASES = [0, 1_000, 2_000, 3_000, 4_000];
+const firstAt = (sent: string[], prefix: string) => {
+  const s = sent.find((x) => x.startsWith(prefix));
+  return s === undefined ? null : Number(s.split("@")[1]);
+};
+
