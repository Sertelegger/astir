{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ensure-daemon.sh",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
              "ASTIR_TOKEN"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47000/hook/claude",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $ASTIR_TOKEN"
            },
            "allowedEnvVars": [
